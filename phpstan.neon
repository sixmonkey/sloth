includes:
    - phpstan-baseline.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 1
    phpVersion: 80400
    paths:
        - src
    excludePaths:
        - tests
        - vendor

        # will be removed
        - src/LayotterBridge
        - src/Model

        # legacy
        - src/wp-config.php
        - src/bootstrap.php
    fileExtensions:
        - php
    bootstrapFiles:
        - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php

    reportUnmatchedIgnoredErrors: false
