{
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\Ramsey\\CaptainHook\\ValidateConventionalCommit"
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting",
        "config": {
          "label": "PHP Syntax Check"
        }
      },
      {
        "action": "\\Unh3ck3d\\PhpCsFixerGitHook\\LintStagedFiles",
        "config": {
          "label": "PHP CS Fixer"
        }
      },
      {
        "action": "\\CaptainHook\\App\\Hook\\File\\Action\\DoesNotContainRegex",
        "options": {
          "regex": "/(?<![a-zA-Z_])var_dump\\s*\\(|(?<![a-zA-Z_])print_r\\s*\\(/",
          "paths": [
            "src/"
          ],
          "ignoreFiles": ["src/functions.php"],
          "fileExtensions": [
            "php"
          ],
          "message": "Debug statements found — remove before committing"
        },
        "config": {
          "label": "Debug Statement Check"
        }
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "vendor/bin/pest --no-progress",
        "config": {
          "label": "Pest Tests"
        }
      }
    ]
  }
}
