<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="{{ site.charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if wp_title %}{{ wp_title }} - {% endif %}{{ site.name }}</title>
    {{ wp_head() }}
</head>
<body {{ body_class() }}>
<main>
    {% block content %}{% endblock %}
</main>
{{ wp_footer() }}
</body>
</html>
