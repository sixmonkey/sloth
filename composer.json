{
  "name": "folvioro/sloth",
  "description": "A WordPress theme framework built with Laravel components",
  "license": "MIT",
  "suggest": {
    "ext-imagick": "Required for generating screenshot.png during theme setup"
  },
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "bitandblack/image-information": "^3.2",
    "brain/hierarchy": "^2.0 || ^3.0",
    "composer/composer": "^2.9",
    "filp/whoops": "^2.18",
    "illuminate/cache": "^12.0",
    "illuminate/config": "^12.0",
    "illuminate/console": "^12.0",
    "illuminate/container": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/events": "^12.0",
    "illuminate/filesystem": "^12.56",
    "illuminate/http": "^12.58",
    "illuminate/pagination": "^12.0",
    "illuminate/support": "^12.0",
    "illuminate/validation": "^12.0",
    "illuminate/view": "^12.0",
    "inpsyde/wp-context": "^1.5",
    "jgrossi/corcel": "^9.0",
    "johnbillion/args": "^2.4",
    "johnbillion/extended-cpts": "^5.1",
    "nunomaduro/termwind": "^2.4",
    "php-debugbar/php-debugbar": "^3.7",
    "spatie/image": "^1.10 || ^2.0 || ^3.0",
    "symfony/filesystem": "^8.0",
    "symfony/process": "^7.4",
    "symfony/routing": "^8.0",
    "twig/twig": "^3.0",
    "vlucas/phpdotenv": "^2.6 || ^3.0 || ^5.0",
    "wp-cli/wp-cli": "^2.12"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "captainhook/captainhook": "^5.29",
    "friendsofphp/php-cs-fixer": "^3.50",
    "pestphp/pest": "^2.0",
    "pestphp/pest-plugin": "^2.0",
    "php-stubs/acf-pro-stubs": "^6.5",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.0",
    "ramsey/conventional-commits": "^1.7",
    "rector/rector": "^2.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "unh3ck3d/php-cs-fixer-git-hook": "^1.0"
  },
  "extra": {
    "branch-alias": {
      "dev-develop": "1.0.x-dev"
    }
  },
  "autoload": {
    "psr-4": {
      "Sloth\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sloth\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage --coverage-html build/coverage",
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "rector": "rector process",
    "rector:dry": "rector process --dry-run",
    "docs": "docker run --rm -v $(pwd):/data phpdoc/phpdoc:3 run -d src -t docs/api -s template.color=deep-purple",
    "post-autoload-dump": [
      "[ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/captainhook install -f -s"
    ]
  }
}
